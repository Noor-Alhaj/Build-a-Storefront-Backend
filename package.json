{
  "name": "online-store-api",
  "version": "1.0.0",
  "description": "Online Store API built with Node.js, Express, and TypeScript",
  "main": "dist/server.js",
   "scripts": {
    "test": "jest --runInBand --detectOpenHandles",
    "test:models": "jest src/models/ --runInBand",
    "test:api": "jest src/tests/api/ --runInBand",
    "test:integration": "jest src/tests/database.test.ts src/tests/security.test.ts --runInBand",
    "test:all": "jest --runInBand --detectOpenHandles --coverage",
    "test:watch": "jest --watch --runInBand",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts"
  },
  "keywords": [
    "api",
    "store",
    "typescript",
    "express"
  ],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "server": "^1.0.42"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/body-parser": "^1.19.5",
    "@types/chai": "^5.2.3",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mocha": "^10.0.10",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^2.0.12",
    "chai": "^6.2.0",
    "jest": "^30.2.0",
    "mocha": "^11.7.4",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.1.6"
  }
}
